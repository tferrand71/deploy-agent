# Connexion à la base PostgreSQL dédiée deploy-agent
DATABASE_URL="postgresql://deploy_agent:motdepasse@postgres:5432/deploy_agent"

# Clé de chiffrement AES-256 pour les secrets (32 octets en base64)
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY="..."

# Répertoire de travail pour les clones Git (dans le conteneur)
REPOS_DIR=/tmp/deploy-agent/repos

# Socket Docker (via socket-proxy)
DOCKER_SOCKET=/var/run/docker.sock

# Jeton exigé sur TOUTE l'API (en-tête « Authorization: Bearer <jeton> »), sauf /health.
# Sans lui, n'importe quel conteneur du VPS qui joint l'agent pourrait lancer ou supprimer des déploiements.
# Obligatoire : l'agent refuse de démarrer s'il manque ou fait moins de 32 caractères.
# Générer avec : openssl rand -hex 32
# La même valeur va dans AGENT_API_TOKEN du dashboard et de deploy-cron.
AGENT_API_TOKEN=

PORT=3001
