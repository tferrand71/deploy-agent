# Connexion à la base PostgreSQL dédiée deploy-agent
DATABASE_URL="postgresql://deploy_agent:motdepasse@postgres:5432/deploy_agent"

# Clé de chiffrement AES-256 pour les secrets (32 octets en base64)
# Générer avec : openssl rand -base64 32
ENCRYPTION_KEY="..."

# Répertoire de travail pour les clones Git (dans le conteneur)
REPOS_DIR=/tmp/deploy-agent/repos

# Socket Docker (via socket-proxy)
DOCKER_SOCKET=/var/run/docker.sock

PORT=3001
