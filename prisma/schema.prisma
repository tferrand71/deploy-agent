generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  repoUrl     String
  branch      String        @default("main")
  subdomain   String        @unique
  lastCommit  String?
  status      ProjectStatus @default(IDLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  secrets     ProjectSecret[]
}

model ProjectSecret {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  key            String
  encryptedValue String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([projectId, key])
}

enum ProjectStatus {
  IDLE
  BUILDING
  RUNNING
  FAILED
}

// Une requête HTTP servie par Traefik, lue dans ses journaux d'accès.
// Aucune IP en clair : `visitor` est une empreinte salée qui change chaque jour.
model AnalyticsHit {
  id         BigInt   @id @default(autoincrement())
  ts         DateTime
  host       String
  path       String
  method     String
  status     Int
  durationMs Int
  bytes      Int
  visitor    String
  referrer   String?
  browser    String?
  os         String?
  device     String?
  bot        Boolean  @default(false)
  pageview   Boolean  @default(false)

  @@index([ts])
  @@index([host, ts])
}

// Curseur de lecture des journaux et sels quotidiens.
model AnalyticsState {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
